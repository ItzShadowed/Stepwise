<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Stepwise – Learn to Code</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F3F6FF;--card:#fff;--ink:#1B2340;--mute:#5b6485;--line:#d9e0f5;--basic:#1FA7A0;--med:#E59F00;--adv:#E8505B;--code:#141a33;--codeink:#dfe6ff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10152b;--card:#1a2142;--ink:#eef1ff;--mute:#9aa4cf;--line:#2c3563;--code:#0b0f20}}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 "Bricolage Grotesque",system-ui,sans-serif}
h1,h2,h3{line-height:1.15;margin:0 0 .5em}
button,input{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--med);outline-offset:2px}
.hide{display:none!important}
.auth{min-height:100vh;display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center;max-width:1050px;margin:0 auto;padding:32px 20px}
.auth h1{font-size:clamp(2.2rem,5vw,3.6rem);font-weight:800;letter-spacing:-.02em}
.auth p.lead{color:var(--mute);max-width:36ch;font-size:1.1rem}
.steps{display:flex;gap:10px;align-items:flex-end;margin-top:28px}
.steps span{flex:1;border-radius:10px 10px 0 0;padding:10px 12px;color:#fff;font-weight:600}
.steps .s1{background:var(--basic);height:70px}.steps .s2{background:var(--med);height:105px}.steps .s3{background:var(--adv);height:140px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px}
.tabs{display:flex;gap:6px;margin-bottom:18px;background:var(--bg);padding:4px;border-radius:12px}
.tabs button{flex:1;border:0;background:none;padding:9px;border-radius:9px;cursor:pointer;font-weight:600;color:var(--mute)}
.tabs button.on{background:var(--ink);color:var(--bg)}
label{display:block;font-weight:600;margin:14px 0 6px}
.field{position:relative}
input[type=email],input[type=password],input[type=text]{width:100%;padding:12px 14px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg)}
.field input{padding-right:48px}
.eye{position:absolute;right:6px;top:50%;transform:translateY(-50%);border:0;background:none;cursor:pointer;padding:8px;border-radius:8px;display:flex}
.eye svg{width:22px;height:22px;stroke:var(--mute);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.btn{width:100%;margin-top:20px;padding:13px;border:0;border-radius:10px;background:var(--ink);color:var(--bg);font-weight:600;cursor:pointer}
.err{color:var(--adv);min-height:1.4em;margin:10px 0 0;font-size:.95rem}
.hint{color:var(--mute);font-size:.88rem;margin:6px 0 0}
.av{width:64px;height:64px;border-radius:50%;overflow:hidden;flex:none;display:inline-flex;background:var(--line)}.av svg{width:100%;height:100%}.av.sm{width:34px;height:34px}
.avrow{display:flex;gap:14px;align-items:center;margin-top:16px}.avrow p{margin:2px 0 6px}
.lvlq{border:0;padding:0;margin:18px 0 0;min-width:0}.lvlq legend{font-weight:600;padding:0;margin-bottom:6px}.lvlq label{display:flex;gap:10px;align-items:flex-start;font-weight:400;margin:6px 0;padding:10px 12px;border:1.5px solid var(--line);border-radius:10px;cursor:pointer;background:var(--bg)}.lvlq label:has(input:checked){border-color:var(--basic)}.lvlq b{display:block;font-weight:600}.lvlq small{color:var(--mute)}.lvlq input{margin-top:5px}
.plans{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin:16px 0}.plan{border:2px solid var(--line);border-radius:14px;padding:16px;background:var(--bg)}.plan.best{border-color:var(--med)}.plan .price{font-size:1.8rem;font-weight:800}.plan .price small{font-size:.9rem;font-weight:400;color:var(--mute)}.plan .btn{margin-top:10px}
.shuf{border:1.5px solid var(--line);background:none;border-radius:8px;padding:6px 12px;cursor:pointer}
header.top{display:flex;justify-content:space-between;align-items:center;gap:12px;max-width:960px;margin:0 auto;padding:18px 20px}
header.top b{font-size:1.3rem;font-weight:800}
.who{display:flex;align-items:center;gap:12px;font-size:.9rem;color:var(--mute)}
.who button{border:1.5px solid var(--line);background:none;border-radius:8px;padding:6px 12px;cursor:pointer}
main{max-width:960px;margin:0 auto;padding:0 20px 60px}
.levels{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:10px 0 26px}
.lv{text-align:left;border:2px solid var(--line);background:var(--card);border-radius:14px;padding:16px;cursor:pointer}
.lv.on{border-color:var(--c)}
.lv i{display:block;height:6px;border-radius:3px;background:var(--line);margin-top:12px;overflow:hidden}
.lv i u{display:block;height:100%;background:var(--c);width:0}
.lv h3{margin:0;color:var(--c)}.lv small{color:var(--mute)}
.layout{display:grid;grid-template-columns:260px 1fr;gap:22px}
.list{display:flex;flex-direction:column;gap:8px}
.list button{text-align:left;border:1.5px solid var(--line);background:var(--card);border-radius:10px;padding:11px 14px;cursor:pointer;display:flex;justify-content:space-between;gap:8px}
.list button.on{border-color:var(--c);background:var(--bg)}
.lesson h2{font-size:1.8rem}
pre{background:var(--code);color:var(--codeink);padding:16px;border-radius:12px;overflow-x:auto;font:400 .92rem/1.6 "JetBrains Mono",ui-monospace,monospace;margin:16px 0}
.quiz{border-top:1px solid var(--line);margin-top:22px;padding-top:18px}
.opt{display:block;width:100%;text-align:left;margin:8px 0;padding:11px 14px;border:1.5px solid var(--line);background:var(--bg);border-radius:10px;cursor:pointer}
.opt.ok{border-color:var(--basic);background:rgba(31,167,160,.15)}.opt.no{border-color:var(--adv);background:rgba(232,80,91,.13)}
.msg{font-weight:600;margin-top:10px}
@media (max-width:760px){.auth,.layout{grid-template-columns:1fr}.auth{gap:24px}.levels{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<section id="auth" class="auth">
  <div>
    <h1>Learn to code, one small step at a time.</h1>
    <p class="lead">Short lessons with real code and a quick check after each one. Start at the level that fits you.</p>
    <div class="steps"><span class="s1">Basic</span><span class="s2">Medium</span><span class="s3">Advanced</span></div>
  </div>
  <div class="card">
    <div class="tabs" role="tablist">
      <button id="tSign" class="on" type="button">Sign up</button>
      <button id="tLog" type="button">Log in</button>
    </div>
    <div>
      <div id="signOnly"><label for="uname">Username</label>
      <input id="uname" type="text" maxlength="20" autocomplete="username" placeholder="Pick a username">
      <div class="avrow"><span class="av" id="avPrev"></span><div><b>Your profile picture</b><p class="hint">We picked a random one for you. Keep it or shuffle for another.</p><button class="shuf" id="shuf" type="button">Shuffle picture</button></div></div>
      <fieldset class="lvlq"><legend>What’s your coding level?</legend>
        <label><input type="radio" name="lvl" value="0"><span><b>Just started</b><small>I’m new to coding</small></span></label>
        <label><input type="radio" name="lvl" value="1"><span><b>Know some code</b><small>I’ve tried a few things</small></span></label>
        <label><input type="radio" name="lvl" value="2"><span><b>Intermediate</b><small>I know some more advanced code</small></span></label>
        <label><input type="radio" name="lvl" value="3"><span><b>Advanced</b><small>I know most advanced code</small></span></label>
      </fieldset></div>
      <label for="email">Gmail address</label>
      <input id="email" type="email" autocomplete="email" placeholder="you@gmail.com">
      <label for="pw">Password</label>
      <div class="field">
        <input id="pw" type="password" autocomplete="current-password" placeholder="At least 6 characters">
        <button class="eye" id="eye" type="button" aria-label="Show password" aria-pressed="false"></button>
      </div>
      <p class="hint" id="pwHint">Click the eye to check what you typed.</p>
      <p class="err" id="err" role="alert"></p>
      <button class="btn" id="go" type="button">Create account</button>
    </div>
  </div>
</section>

<div id="app" class="hide">
  <header class="top">
    <b>Stepwise</b>
    <div class="who"><span class="av sm" id="meAv"></span><span id="me"></span><button id="out" type="button">Log out</button></div>
  </header>
  <main>
    <h2 id="hello">Pick a level</h2>
    <div class="levels" id="levels"></div>
    <div class="layout"><div class="list" id="list"></div><article class="card lesson" id="lesson"></article></div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script>
const LV=[{"id": "basic", "name": "Basic", "sub": "Your first lines of code", "c": "#1FA7A0", "lessons": [{"t": "Variables", "x": "A variable stores a value under a name so you can use it later. Use const for values that won’t change and let for values that will.", "c": "const name = \"Sam\";\nlet score = 10;\nscore = score + 5;\nconsole.log(name, score); // Sam 15", "q": "Which keyword creates a value that can’t be reassigned?", "o": ["let", "const", "print"], "a": 1}, {"t": "Conditions", "x": "An if statement runs code only when a condition is true. Add else for the other case.", "c": "const age = 14;\nif (age >= 13) {\n  console.log(\"Teen account\");\n} else {\n  console.log(\"Kid account\");\n}", "q": "What does 5 > 3 evaluate to?", "o": ["true", "false", "5"], "a": 0}, {"t": "Loops", "x": "A loop repeats code. A for loop has a start, a stopping rule and a step.", "c": "for (let i = 0; i < 3; i++) {\n  console.log(\"Round\", i);\n}\n// Round 0, Round 1, Round 2", "q": "How many times does for (let i = 0; i < 3; i++) run?", "o": ["2", "3", "4"], "a": 1}]}, {"id": "medium", "name": "Medium", "sub": "Build reusable pieces", "c": "#E59F00", "lessons": [{"t": "Functions"}, {"t": "Arrays and map"}, {"t": "Objects"}]}, {"id": "adv", "name": "Advanced", "sub": "Think like an engineer", "c": "#E8505B", "lessons": [{"t": "Async and await"}, {"t": "Closures"}, {"t": "Binary search"}]}];

const $=id=>document.getElementById(id);
const store={get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
const EYE='<svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>';
const EYEOFF='<svg viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.5 7 10 7c1.7 0 3.2-.4 4.5-1M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>';
let mode="sign",user=null,lv=0,ls=0,prog={};

async function hash(s){try{const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(s));return Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,"0")).join("")}catch(e){return btoa(unescape(encodeURIComponent(s)))}}

function avatar(seed){
  const P=["#1FA7A0","#E59F00","#E8505B","#6C63FF","#2E9CCA","#8E5BD9","#3DAA5C","#F06595"],SK=["#F5D0B5","#E0A980","#B97A52","#8A5A3B"],HR=["#2b2118","#6b3f1d","#d8a63a","#1b2340"];
  const r=n=>{seed=(seed*9301+49297)%233280;return Math.floor(seed/233280*n)};
  const bg=P[r(8)],sk=SK[r(4)],hr=HR[r(4)],mo=r(3),ey=r(2);
  const eyes=ey?'<circle cx="26" cy="36" r="1.9" fill="#1b2340"/><circle cx="38" cy="36" r="1.9" fill="#1b2340"/>':'<path d="M24 36h4M36 36h4" stroke="#1b2340" stroke-width="2" stroke-linecap="round"/>';
  const mouth=[ '<path d="M27 42q5 5 10 0" stroke="#1b2340" stroke-width="2" fill="none" stroke-linecap="round"/>','<path d="M28 43h8" stroke="#1b2340" stroke-width="2" stroke-linecap="round"/>','<circle cx="32" cy="43" r="2.4" fill="#1b2340"/>'][mo];
  return '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="'+bg+'"/><path d="M10 64a22 18 0 0 1 44 0z" fill="#fff" opacity=".85"/><circle cx="32" cy="35" r="16" fill="'+sk+'"/><path d="M16 33a16 16 0 0 1 32 0c-6-6-26-6-32 0z" fill="'+hr+'"/>'+eyes+mouth+'</svg>';
}
let avSeed=Math.floor(Math.random()*1e6)+1;
$("avPrev").innerHTML=avatar(avSeed);
$("shuf").onclick=()=>{avSeed=Math.floor(Math.random()*1e6)+1;$("avPrev").innerHTML=avatar(avSeed)};
$("eye").innerHTML=EYE;
$("eye").onclick=()=>{const p=$("pw"),show=p.type==="password";p.type=show?"text":"password";$("eye").innerHTML=show?EYEOFF:EYE;$("eye").setAttribute("aria-label",show?"Hide password":"Show password");$("eye").setAttribute("aria-pressed",show)};
function setMode(m){mode=m;$("tSign").classList.toggle("on",m==="sign");$("tLog").classList.toggle("on",m==="log");$("go").textContent=m==="sign"?"Create account":"Log in";$("signOnly").classList.toggle("hide",m!=="sign");$("pw").autocomplete=m==="sign"?"new-password":"current-password";$("err").textContent=""}
$("tSign").onclick=()=>setMode("sign");$("tLog").onclick=()=>setMode("log");

const SB_URL="https://ootujxngqczxdoiijrve.supabase.co",SB_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9vdHVqeG5ncWN6eGRvaWlqcnZlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU2NTY5NzgsImV4cCI6MjEwMTIzMjk3OH0.JNuQ6F2M2eJDbBtP1E4Q6NVKgN2g0vrHtB1-o1VyEvQ";
const sb=window.supabase.createClient(SB_URL,SB_KEY);
async function submit(){
  const email=$("email").value.trim().toLowerCase(),pw=$("pw").value,err=$("err"),btn=$("go");
  if(!/^[a-z0-9._%+-]+@gmail\.com$/.test(email)){err.textContent="Enter a Gmail address that ends in @gmail.com.";return}
  if(pw.length<6){err.textContent="Your password needs at least 6 characters.";return}
  err.textContent="";btn.disabled=true;
  try{
    if(mode==="sign"){
      const u=$("uname").value.trim();
      if(!/^[A-Za-z0-9_.]{3,20}$/.test(u)){err.textContent="Username must be 3\u201320 characters: letters, numbers, _ or .";return}
      const lr=document.querySelector('input[name=lvl]:checked');
      if(!lr){err.textContent="Choose your coding level.";return}
      const ok=await sb.rpc("stepwise_username_available",{name:u});
      if(ok.error){err.textContent="Couldn\u2019t check the username. Try again.";return}
      if(!ok.data){err.textContent="That username is taken. Try another.";return}
      const r=await sb.auth.signUp({email,password:pw,options:{data:{app:"stepwise",username:u,avatar_seed:avSeed,level:+lr.value}}});
      if(r.error){err.textContent=r.error.message;return}
      if(r.data.user&&r.data.user.identities&&r.data.user.identities.length===0){err.textContent="That Gmail already has an account. Switch to Log in.";return}
      if(!r.data.session){setMode("log");err.textContent="Check your Gmail inbox and confirm your email, then log in.";return}
      await load(r.data.session.user);
    }else{
      const r=await sb.auth.signInWithPassword({email,password:pw});
      if(r.error){err.textContent=r.error.message==="Invalid login credentials"?"Wrong email or password. Click the eye to check what you typed.":r.error.message;return}
      await load(r.data.user);
    }
  }catch(e){err.textContent="Couldn\u2019t reach the server. Check your connection."}finally{btn.disabled=false}
}
$("go").onclick=submit;
$("pw").addEventListener("keydown",e=>{if(e.key==="Enter")submit()});
$("out").onclick=async()=>{try{await sb.auth.signOut()}catch(e){}location.reload()};

const PAY={medium:"https://buy.stripe.com/test_8x228s5Dq9XVfyE0qu0Fi00",advanced:"https://buy.stripe.com/test_dRmbJ23vi4DB4U04GK0Fi01",bundle:"https://buy.stripe.com/test_28EbJ23vi2vt4U05KO0Fi02"}; // paste your payment links here
let ents=[];
const has=i=>i===0||ents.includes("bundle")||(i===1&&ents.includes("medium"))||(i===2&&ents.includes("advanced"));
async function loadPaid(){
  const e=await sb.from("stepwise_entitlements").select("plan").eq("user_id",user.id);
  ents=(e.data||[]).map(r=>r.plan);
  const r=await sb.from("stepwise_lessons").select("level,idx,body");
  (r.data||[]).forEach(row=>{const L=LV.find(l=>l.id===row.level);if(L&&L.lessons[row.idx])Object.assign(L.lessons[row.idx],row.body)});
}
function paywall(el){
  const P=[];
  if(!has(1))P.push(["medium","Medium","$7.67","All Medium lessons"]);
  if(!has(2))P.push(["advanced","Advanced","$13.10","All Advanced lessons"]);
  if(!has(1)&&!has(2))P.push(["bundle","Bundle","$15.42","Medium and Advanced together. Save $5.35"]);
  el.innerHTML="<h2>"+LV[lv].name+" is locked</h2><p>Unlock it to open every lesson in the level.</p><div class='plans'>"+P.map(p=>"<div class='plan"+(p[0]==="bundle"?" best":"")+"'><b>"+p[1]+"</b><div class='price'>"+p[2]+" <small>USD</small></div><p class='hint'>"+p[3]+"</p><button class='btn buy' data-p='"+p[0]+"' type='button'>Unlock</button></div>").join("")+"</div><p class='err' id='payMsg'></p><button class='shuf' id='refAcc' type='button'>I\u2019ve paid, refresh my access</button>";
  el.querySelectorAll(".buy").forEach(b=>b.onclick=()=>{const k=b.dataset.p;if(!PAY[k]){$("payMsg").textContent="Payments aren\u2019t connected yet. Please check back soon.";return}window.open(PAY[k]+"?client_reference_id="+encodeURIComponent(user.id)+"&prefilled_email="+encodeURIComponent(user.email),"_blank")});
  $("refAcc").onclick=async()=>{await loadPaid();render()};
}
async function load(u){
  user=u;
  let p=(await sb.from("stepwise_profiles").select("username,avatar_seed,level").eq("user_id",u.id).maybeSingle()).data;
  if(!p){
    const name=u.email.split("@")[0].replace(/[^A-Za-z0-9_.]/g,"").slice(0,15).padEnd(3,"x")+Math.floor(100+Math.random()*900);
    p={username:name,avatar_seed:Math.floor(Math.random()*1e6)+1,level:0};
    await sb.from("stepwise_profiles").insert({user_id:u.id,username:p.username,avatar_seed:p.avatar_seed,level:p.level});
  }
  const rows=(await sb.from("stepwise_progress").select("lesson_key").eq("user_id",u.id)).data||[];
  prog={};rows.forEach(r=>{prog[r.lesson_key]=1});
  await loadPaid();
  show(p);
}
function show(p){
  $("auth").classList.add("hide");$("app").classList.remove("hide");
  $("me").textContent=p.username+" ("+["Just started","Knows some code","Intermediate","Advanced"][p.level]+")";$("meAv").innerHTML=avatar(p.avatar_seed);$("hello").textContent="Welcome, "+p.username;
  lv=has([0,0,1,2][p.level])?[0,0,1,2][p.level]:0;ls=0;render();window.scrollTo(0,0);
}
const done=(l,i)=>prog[LV[l].id+i];
function render(){
  $("levels").innerHTML="";
  LV.forEach((L,i)=>{
    const n=L.lessons.filter((_,j)=>done(i,j)).length;
    const b=document.createElement("button");b.className="lv"+(i===lv?" on":"");b.style.setProperty("--c",L.c);b.type="button";
    b.innerHTML="<h3>"+L.name+(has(i)?"":" \ud83d\udd12")+"</h3><small>"+L.sub+"</small><i><u style='width:"+n/L.lessons.length*100+"%'></u></i>";
    b.onclick=()=>{lv=i;ls=0;render()};$("levels").appendChild(b);
  });
  const L=LV[lv];$("list").innerHTML="";
  L.lessons.forEach((s,j)=>{
    const b=document.createElement("button");b.type="button";b.className=j===ls?"on":"";b.style.setProperty("--c",L.c);
    b.innerHTML="<span>"+s.t+"</span><span>"+(!has(lv)?"\ud83d\udd12":done(lv,j)?"✓":"")+"</span>";
    b.onclick=()=>{ls=j;render()};$("list").appendChild(b);
  });
  const s=L.lessons[ls],el=$("lesson");el.innerHTML="";
  if(!has(lv)){paywall(el);return}
  const h=document.createElement("h2");h.textContent=s.t;
  const p=document.createElement("p");p.textContent=s.x;
  const pre=document.createElement("pre");pre.textContent=s.c;
  const q=document.createElement("div");q.className="quiz";
  const qh=document.createElement("h3");qh.textContent="Quick check: "+s.q;q.appendChild(qh);
  const m=document.createElement("div");m.className="msg";
  if(done(lv,ls))m.textContent="You’ve completed this lesson.";
  s.o.forEach((t,k)=>{
    const o=document.createElement("button");o.type="button";o.className="opt";o.textContent=t;
    o.onclick=()=>{
      if(k===s.a){o.classList.add("ok");m.textContent="Correct! Lesson complete.";m.style.color="var(--basic)";
        if(!done(lv,ls)){prog[L.id+ls]=1;sb.from("stepwise_progress").insert({user_id:user.id,lesson_key:L.id+ls}).then(()=>{});setTimeout(render,700)}}
      else{o.classList.add("no");m.textContent="Not quite. Re-read the lesson and try again.";m.style.color="var(--adv)"}
    };q.appendChild(o);
  });
  q.appendChild(m);el.append(h,p,pre,q);
}
